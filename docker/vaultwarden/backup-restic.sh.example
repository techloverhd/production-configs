#!/usr/bin/env bash
set -eo pipefail

export RESTIC_REPOSITORY="s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/vaultwarden-backups"
export AWS_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
export AWS_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
export RESTIC_PASSWORD="<STRONG_RESTIC_ENCRYPTION_PASSWORD>"

BACKUP_SOURCE="/path/to/vaultwarden/vw-data"
SQLITE_DB="${BACKUP_SOURCE}/db.sqlite3"
TEMP_DUMP="/tmp/vaultwarden-backup-dump.sqlite3"

# Safe SQLite snapshot without stopping container
sqlite3 "${SQLITE_DB}" ".backup '${TEMP_DUMP}'"

# Execute restic backup
restic backup "${TEMP_DUMP}" "${BACKUP_SOURCE}/attachments" "${BACKUP_SOURCE}/rsa_key.pem" --tag automated

# Clean up temporary database snapshot
rm -f "${TEMP_DUMP}"

# Retention policy: keep last 14 dailies, 4 weeklies, 6 monthlies
restic forget --keep-daily 14 --keep-weekly 4 --keep-monthly 6 --prune
